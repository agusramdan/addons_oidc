<?xml version="1.0"?>
<odoo>
        <record id="view_trust_audience_form" model="ir.ui.view">
            <field name="name">trust.audience.form</field>
            <field name="model">trust.audience</field>
            <field name="arch" type="xml">
                <form string="arch">
                    <sheet>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
<!--                            <field name="issuer_ids" widget="many2many_tags"/>-->
                        </group>
                    </sheet>
                </form>
            </field>
        </record>        
        <record id="view_trust_audience_tree" model="ir.ui.view">
            <field name="name">trust.audience.tree</field>
            <field name="model">trust.audience</field>
            <field name="arch" type="xml">
                <tree string="arch">
                    <field name="name" />
<!--                    <field name="issuer_ids" widget="many2many_tags"/>-->
                </tree>
            </field>
        </record>
        <record id="action_trust_audience" model="ir.actions.act_window">
            <field name="name">Trust Audience</field>
            <field name="res_model">trust.audience</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="menu_trust_audiences" name="Trust Audience"
            parent="base.menu_users" sequence="30"
            action="action_trust_audience" groups="base.group_no_one"/>
</odoo>
