<?xml version="1.0"?>
<odoo>
    <data>
        <record id="module_category_pdf_sign" model="ir.module.category">
            <field name="name">PDF Digital Signature</field>
            <field name="description">
                Access rights for PDF Digital Signature
            </field>
            <field name="sequence">30</field>
            <field name="exclusive" eval="1"/>
        </record>

        <record id="group_pdf_sign_user" model="res.groups">
            <field name="name">PDF Sign User</field>
            <field name="category_id" ref="module_category_pdf_sign"/>
        </record>

        <record id="group_pdf_sign_manager" model="res.groups">
            <field name="name">PDF Sign Manager</field>
            <field name="category_id" ref="module_category_pdf_sign"/>
            <field name="implied_ids"
                   eval="[(4, ref('amr_esign_pdf.group_pdf_sign_user'))]"/>
        </record>
        <record id="group_pdf_sign_admin" model="res.groups">
            <field name="name">CA Administrator</field>
            <field name="category_id" ref="module_category_pdf_sign"/>
            <field name="implied_ids"
                   eval="[(4, ref('amr_esign_pdf.group_pdf_sign_manager'))]"
            />
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids"
                   eval="[(4, ref('amr_esign_pdf.group_pdf_sign_admin'))]"/>
        </record>
    </data>
</odoo>
