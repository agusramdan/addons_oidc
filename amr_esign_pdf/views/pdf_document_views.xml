<odoo>
  <data>
    <record id="view_pdf_document_tree" model="ir.ui.view">
      <field name="name">pdf.document.tree</field>
      <field name="model">pdf.document</field>
      <field name="arch" type="xml">
        <tree string="PDF Documents">
          <field name="name"/>
          <field name="state"/>
          <field name="signed_pdf_filename"/>
        </tree>
      </field>
    </record>

    <record id="view_pdf_document_form" model="ir.ui.view">
      <field name="name">pdf.document.form</field>
      <field name="model">pdf.document</field>
      <field name="arch" type="xml">
        <form string="PDF Document">
          <header>
              <button name="action_sign_pdf" type="object" string="Sign PDF" class="btn-primary"/>
          </header>
          <sheet>
            <group>
              <field name="name"/>
              <field name="state"/>
            </group>
            <group>
              <field name="pdf_file" filename="pdf_filename"/>
              <field name="pdf_filename" />
            </group>
            <group>
              <field name="signed_pdf" filename="signed_pdf_filename"/>
              <field name="signed_pdf_filename"/>
            </group>
            <group>
              <field name="signature_ids"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_pdf_document" model="ir.actions.act_window">
      <field name="name">PDF Documents</field>
      <field name="res_model">pdf.document</field>
      <field name="view_mode">tree,form</field>
      <field name="help" type="html">
        <p class="oe_view_nocontent_create">Create a new PDF document to be signed.</p>
      </field>
    </record>
  </data>
</odoo>
