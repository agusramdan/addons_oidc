<odoo>
  <data>
    <record id="amr_esign_pdf.view_pdf_document_tree" model="ir.ui.view">
      <field name="name">pdf.document.tree</field>
      <field name="model">pdf.document</field>
      <field name="arch" type="xml">
        <tree string="PDF Documents">
          <field name="name"/>
          <field name="state"/>
          <field name="pdf_filename"/>
          <field name="signed_pdf_filename"/>
        </tree>
      </field>
    </record>

    <record id="amr_esign_pdf.view_pdf_document_form" model="ir.ui.view">
      <field name="name">pdf.document.form</field>
      <field name="model">pdf.document</field>
      <field name="arch" type="xml">
        <form string="PDF Document">
          <sheet>
            <group>
              <field name="name"/>
              <field name="state"/>
            </group>
            <group>
              <field name="pdf_file" filename="pdf_filename"/>
              <field name="pdf_filename"/>
            </group>
            <group>
              <field name="pdf_hash" readonly="1"/>
              <field name="pdf_lock" filename="pdf_filename"/>
            </group>
            <group>
              <field name="signed_pdf" filename="signed_pdf_filename"/>
              <field name="signed_pdf_filename"/>
            </group>
            <group>
              <field name="signature_ids"/>
            </group>
            <footer>
              <button name="action_prepare_signature" type="object" string="Prepare Signature" class="btn-secondary"/>
              <button name="action_sign_pdf" type="object" string="Sign PDF" class="btn-primary"/>
              <button name="action_reset" type="object" string="Reset" class="btn-secondary"/>
            </footer>
          </sheet>
        </form>
      </field>
    </record>

    <record id="amr_esign_pdf.action_pdf_document" model="ir.actions.act_window">
      <field name="name">PDF Documents</field>
      <field name="res_model">pdf.document</field>
      <field name="view_mode">tree,form</field>
      <field name="help" type="html">
        <p class="oe_view_nocontent_create">Create a new PDF document to be signed.</p>
      </field>
    </record>

    <menuitem id="amr_esign_pdf.menu_pdf_document_root" name="AMR ESign PDF"/>
    <menuitem id="amr_esign_pdf.menu_pdf_document" name="Documents" parent="amr_esign_pdf.menu_pdf_document_root" action="amr_esign_pdf.action_pdf_document"/>
  </data>
</odoo>
