<odoo>
  <data>
    <record id="amr_esign_pdf.view_user_ca_data_tree" model="ir.ui.view">
      <field name="name">user.ca.data.tree</field>
      <field name="model">user.ca.data</field>
      <field name="arch" type="xml">
        <tree string="CA Data">
          <field name="name"/>
          <field name="user_id"/>
        </tree>
      </field>
    </record>

    <record id="amr_esign_pdf.view_user_ca_data_form" model="ir.ui.view">
      <field name="name">user.ca.data.form</field>
      <field name="model">user.ca.data</field>
      <field name="arch" type="xml">
        <form string="User CA Data">
          <sheet>
            <group>
              <field name="name"/>
              <field name="user_id"/>
            </group>
            <group>
              <field name="certificate"/>
              <field name="private_key"/>
              <field name="public_key" readonly="1"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="amr_esign_pdf.action_user_ca_data" model="ir.actions.act_window">
      <field name="name">User CA Data</field>
      <field name="res_model">user.ca.data</field>
      <field name="view_mode">tree,form</field>
    </record>

  </data>
</odoo>
