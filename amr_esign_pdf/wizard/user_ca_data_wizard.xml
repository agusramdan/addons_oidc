<odoo>
  <data>
    <record id="amr_esign_pdf.view_user_ca_data_wizard_form" model="ir.ui.view">
      <field name="name">user.ca.data.wizard.form</field>
      <field name="model">user.ca.data.wizard</field>
      <field name="arch" type="xml">
        <form string="Generate CA Data">
          <sheet>
            <group>
              <group>
                <field name="name"/>
                <field name="user_id"/>
                <field name="org_name"/>
              </group>
              <group>
                <field name="private_key_password" type="password" />
                <field name="algorithm"/>
                <field name="validity_days"/>
                <field name="serial_number" readonly="1"/>
              </group>
            </group>
            <group>
              <field name="certificate"/>
              <field name="private_key"/>
            </group>
            <footer>
              <button name="action_generate_keypair" type="object" string="Generate Keypair" class="btn-default"/>
              <button name="action_create_ca_data" type="object" string="Create CA Data" class="btn-primary"/>
              <button string="Cancel" class="btn-secondary" special="cancel"/>
            </footer>
          </sheet>
        </form>
      </field>
    </record>

    <record id="amr_esign_pdf.action_user_ca_data_wizard" model="ir.actions.act_window">
      <field name="name">Generate CA Data</field>
      <field name="res_model">user.ca.data.wizard</field>
      <field name="view_mode">form</field>
      <field name="target">new</field>
    </record>

  </data>
</odoo>
