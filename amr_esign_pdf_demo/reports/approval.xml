<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_approval_form" model="ir.actions.report">
        <field name="name">Approval Form</field>
        <field name="model">pdf.document.demo</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">amr_esign_pdf_demo.report_approval_form</field>
        <field name="report_file">amr_esign_pdf_demo.report_approval_form</field>
        <field name="print_report_name">'Approval - %s' % (object.name)</field>
    </record>

    <template id="report_approval_form">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <style type="text/css">
                    .placeholder_esign_pdf {
                        color: #999999;
                        text-align: left;
                        vertical-align: bottom;
                    }

                    table.approval {
                        width: 100%;
                        border-collapse: collapse;
                    }

                    table.approval td,
                    table.approval th {
                        border: 1px solid #000;
                        padding: 4px;
                    }
                    .approval_row {
                        height: 100px;
                    }
                    .approval_row td {
                        height: 100px;
                        vertical-align: bottom;
                    }
                </style>

                    <div class="page">

                        <h2 style="text-align:center">
                            APPROVAL FORM
                        </h2>

                        <table class="table table-sm table-bordered" style="width:100%;">
                            <tbody>
                                <tr>
                                    <td width="25%"><strong>Approval No</strong></td>
                                    <td width="25%">
                                        <span t-field="o.name"/>
                                    </td>

                                    <td width="25%"><strong>Date</strong></td>
                                    <td width="25%">
                                        <span t-field="o.create_date"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td><strong>Description</strong></td>
                                    <td colspan="3">
                                        <span t-field="o.description"/>
                                    </td>
                                </tr>

                            </tbody>
                        </table>

                        <br/>

                        <h4>Approval List</h4>

                        <table class="table table-sm table-bordered" style="width:100%;">
                            <thead>
                                <tr>
                                    <th width="5%">No</th>
                                    <th width="95%">Signature</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr class="approval_row">
                                    <td>
                                        1
                                    </td>
                                    <td class="placeholder_esign_pdf">
                                        [[signature_requester_placeholder]]
                                    </td>

                                </tr>
                                <tr t-foreach="o.approval_task_line" t-as="line" class="approval_row">
                                    <td>
                                        <span t-esc="line_index + 2"/>
                                    </td>
                                    <td class="placeholder_esign_pdf">
                                        <t t-esc="'[[signature_approvar_%s_placeholder]]' % line.id"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
