<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="provider_auto_login" model="auth.oauth.provider">
            <field name="name">OIDC</field>
            <field name="issuer_url">https://www.agusramdan.tech</field>
            <field name="auth_endpoint">https://www.agusramdan.tech/oidc/auth</field>
            <field name="scope">userinfo approval</field>
            <field name="validation_endpoint">https://www.agusramdan.tech/oidc/introspect</field>
            <field name="data_endpoint">https://agusramdan.tech/oidc/userinfo</field>
            <field name="css_class">fa fa-fw o_custom_icon</field>
            <field name="body">Log in with OIDC</field>
            <field name="enabled" eval="True" />
        </record>

        <!-- Use url uuid as client_id for OpenERP oauth provider -->
        <function model="auth.oauth.provider" name="write">
            <value eval="[ref('amr_oauth.provider_auto_login')]" />
            <value model="ir.config_parameter" eval="{
                'client_id': obj().env['ir.config_parameter'].get_param('web.base.url')),
            }" />
        </function>

    </data>
</odoo>
