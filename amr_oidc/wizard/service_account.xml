<?xml version="1.0"?>
<odoo>
    <record id="view_oidc_service_account_wizard_form" model="ir.ui.view">
        <field name="name">oidc.service.account.wizard.form</field>
        <field name="model">oidc.service.account.wizard</field>
        <field name="arch" type="xml">
            <form string="Service Account">
                <group>
                    <field name="algorithm" />
                    <field name="client_id" />
                    <field name="file_name" readonly="1"/>
                </group>
                <group>
                    <field name="json_content" readonly="1" widget="text"/>
                </group>
                <group>
                    <field name="file_data" filename="file_name" />
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="oe_highlight"/>
                    <button name="action_save" type="object" string="Save" class="oe_highlight"/>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
