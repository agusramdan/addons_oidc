<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div id="amr_resource_addons" class="app_settings_block"
                     data-string="amr_resource_addons" string="Server Resource"
                     data-key="amr_resource_addons" groups="base.group_erp_manager">
                    <div id="amr_resource_config" groups="base.group_erp_manager">
                        <h2>Resource</h2>
                        <div class="row mt16 o_settings_container" id="amr_token_enabled_setting">
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_right_pane">
                                    <div class="row">
                                        <label for="amr_select_audience" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="amr_select_audience" nolabel="1"/>
                                    </div>
                                    <div class="row">
                                        <label for="amr_web_base_url_freeze" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="amr_web_base_url_freeze" attrs="{'invisible':[('amr_select_audience','!=','web.base.url')]}"/>
                                        <div class="col-9" attrs="{'invisible':[('amr_select_audience','!=','web.base.url')]}">
                                            <button name="action_edit_web_base_url" type="object" string="Edit" class="oe_highlight"/>
                                        </div>
                                    </div>
                                    <div class="mt16 row">
                                        <div class="col-9">
                                            <field name="amr_resource_audience" nolabel="1" widget="CopyClipboardChar"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_amr_approval_aggregator"/>
                                </div>
                                <div class="o_setting_right_pane" >
                                    <div class="content-group">
                                        <label for="module_amr_approval_aggregator"/>
                                        <div class="text-muted" id="module_amr_approval_aggregator_description">
                                            Approval Aggregator
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="amr_resource_app">
                        <h2>Token and OIDC</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_amr_token"/>
                                </div>
                                <div class="o_setting_right_pane" >
                                    <div class="content-group">
                                        <label for="module_amr_token"/>
                                        <div class="text-muted" id="module_amr_token_description">
                                            Token Provider Server
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_amr_oidc"/>
                                </div>
                                <div class="o_setting_right_pane" >
                                    <div class="content-group">
                                        <label for="module_amr_oidc"/>
                                        <div class="text-muted">
                                            OIDC Server
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_amr_esign_pdf"/>
                                </div>
                                <div class="o_setting_right_pane" >
                                    <div class="content-module_amr_esign_pdf">
                                        <label for="module_amr_esign_pdf"/>
                                        <div class="text-muted">
                                            E-Signature PDF
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_amr_auto_login"/>
                                </div>
                                <div class="o_setting_right_pane" >
                                    <div class="content-group">
                                        <label for="module_amr_auto_login"/>
                                        <div class="text-muted">
                                            OIDC Client Auto Login (Experimental)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="amr_integration_app">
                        <h2>Integration</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_amr_service_client"/>
                                </div>
                                <div class="o_setting_right_pane" >
                                    <div class="content-group" id="amr_service_client_content_group">
                                        <label for="module_amr_service_client"/>
                                        <div class="text-muted" id="module_amr_service_client">
                                            Service Client / Connect to Other System
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_amr_data_push"/>
                                </div>
                                <div class="o_setting_right_pane" >
                                    <div class="content-group">
                                        <label for="module_amr_data_push"/>
                                        <div class="text-muted">
                                            Data Push To Other system when change
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_amr_data_sync"/>
                                </div>
                                <div class="o_setting_right_pane" id="amr_data_sync_setting_box">
                                    <div class="content-group">
                                        <label for="module_amr_data_sync"/>
                                        <div class="text-muted">
                                            Data Sync From Other system
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_amr_approval_task_client"/>
                                </div>
                                <div class="o_setting_right_pane"  >
                                    <div class="content-group" id="amr_approval_task_client_content_group">
                                        <label for="module_amr_approval_task_client"/>
                                        <div class="text-muted">
                                            Approval Task Client
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_amr_notification_client"/>
                                </div>
                                <div class="o_setting_right_pane"  >
                                    <div class="content-group" id="amr_notification_client_content_group">
                                        <label for="module_amr_notification_client"/>
                                        <div class="text-muted">
                                            Notification Client
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
