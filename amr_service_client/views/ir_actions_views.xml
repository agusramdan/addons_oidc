<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="ir_actions_server_view_form"  model="ir.ui.view">
        <field name="name">ir.actions.server.view.form.inherit.service.client</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='link_field_id']" position="after">
                <field name="service_client_id"
                    attrs="{'invisible': [('state', '!=', 'service_client')],
                            'required': [('state', '=', 'service_client')]}"/>

            </xpath>
        </field>
    </record>

</data></odoo>
