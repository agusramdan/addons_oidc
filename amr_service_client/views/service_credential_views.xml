<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_service_credential_tree" model="ir.ui.view">
        <field name="name">service.credential.tree</field>
        <field name="model">service.credential</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="source"/>
                <field name="reference"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_service_credential_form" model="ir.ui.view">
        <field name="name">service.credential.form</field>
        <field name="model">service.credential</field>
        <field name="arch" type="xml">
            <form string="Credential">
                <header>
                    <button
                            name="action_config_credential" type="object"
                            string="Config Credential" class="oe_highlight"
                    />
                </header>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="source"/>
                    </group>

                    <group>

                        <field
                            name="reference"
                            attrs="{
                                'invisible': [
                                    ('source', '=', 'database')
                                ],
                                'required': [
                                    ('source', '!=', 'database')
                                ]
                            }"
                        />

                        <field
                            name="credential_json"
                            widget="text"
                            nolabel="1"
                            attrs="{
                                'invisible': [
                                    ('source', '!=', 'database')
                                ],
                                'required': [
                                    ('source', '=', 'database')
                                ]
                            }"
                        />

                    </group>

                    <notebook>

                        <page string="Help">

                            <group string="Database">
                                <div>
                                    Credential JSON disimpan langsung
                                    di database.
                                </div>
                            </group>
                            <group string="File Path">
                                <div>
                                    Reference berisi path file JSON.
                                    Contoh:
                                    /etc/odoo/credentials/hr.json
                                </div>
                            </group>
                            <group string="Environment JSON">
                                <div>
                                    Reference berisi nama environment
                                    variable yang berisi JSON credential.
                                </div>
                            </group>
                            <group string="Environment Path">
                                <div>
                                    Reference berisi nama environment
                                    variable yang berisi lokasi file JSON.
                                </div>
                            </group>
                            <group string="Config Path">
                                <div>
                                    Reference berisi key pada odoo.conf.
                                </div>
                            </group>
                            <group string="System Parameter JSON">
                                <div>
                                    Reference berisi key
                                    ir.config_parameter yang
                                    menyimpan JSON credential.
                                </div>
                            </group>
                            <group string="System Parameter Path">
                                <div>
                                    Reference berisi key
                                    ir.config_parameter yang
                                    menyimpan path file JSON.
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->

    <record id="action_service_credential" model="ir.actions.act_window">
        <field name="name">Credentials</field>
        <field name="res_model">service.credential</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
