<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->

    <record id="view_service_credential_wizard_form" model="ir.ui.view">
        <field name="name">service.credential.wizard.form</field>
        <field name="model">service.credential.wizard</field>
        <field name="arch" type="xml">
            <form string="Credential Generator">

                <group>
                    <field name="credential_type"/>
                    <field name="version"/>
                </group>

                <notebook>
                    <page string="JSON">
                        <field name="json_content" nolabel="1"/>
                    </page>
                    <page string="OAuth" args="{'invisible':[('credential_type','not in',['service_account','client_secret'])]}" >
                        <group>
                            <field name="client_id"/>
                            <field name="token_uri"/>
                        </group>
                    </page>

                    <page string="Service Account" args="{'invisible':[('credential_type','not in',['service_account'])]}">
                        <group>
                            <field name="private_key_id"/>
                            <field name="private_key_file"/>
                            <field name="private_key"/>
                        </group>
                    </page>

                    <page string="Client Secret" args="{'invisible':[('credential_type','not in',['client_secret'])]}">
                        <group>
                            <field name="client_secret"/>
                        </group>
                    </page>

                    <page string="API Key" args="{'invisible':[('credential_type','!=','api_key')]}">
                        <group>
                            <field name="header"/>
                            <field name="value"/>
                        </group>
                    </page>

                    <page string="Bearer" args="{'invisible':[('credential_type','!=','bearer')]}">
                        <group>
                            <field name="token"/>
                        </group>
                    </page>

                    <page string="Basic" args="{'invisible':[('credential_type','!=','basic')]}">
                        <group>
                            <field name="username"/>
                            <field name="password"/>
                        </group>
                    </page>



                </notebook>

                <footer>
                    <button
                        name="action_generate"
                        type="object"
                        string="Generate JSON"
                        class="oe_highlight"/>

                    <button
                        name="action_save_to_credential"
                        type="object"
                        string="Save to Credential"/>

                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"/>

                </footer>
            </form>
        </field>
    </record>
</odoo>
