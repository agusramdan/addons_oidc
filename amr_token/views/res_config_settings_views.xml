<odoo>
    <record id="view_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div id="amr_token_addons" class="app_settings_block"
                     data-string="amr_token" string="Token Addons"
                     data-key="amr_token_addons" groups="base.group_erp_manager">
                    <div id="amr_token">
                        <h2>Token</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_amr_oidc"/>
                                </div>
                                <div class="o_setting_right_pane" >
                                    <div class="content-group">
                                        <label for="module_amr_oidc"/>
                                        <div class="text-muted">
                                            OIDC Server
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_amr_oauth"/>
                                </div>
                                <div class="o_setting_right_pane" >
                                    <div class="content-module_amr_auth_oauth">
                                        <label for="module_amr_oauth"/>
                                        <div class="text-muted">
                                            OIDC Client
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_amr_auto_login"/>
                                </div>
                                <div class="o_setting_right_pane" >
                                    <div class="content-group">
                                        <label for="module_amr_auto_login"/>
                                        <div class="text-muted">
                                            OIDC Client auto login (Experimental)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="amr_token_config" groups="base.group_erp_manager">
                        <h2>Configuration</h2>
                        <div class="row mt16 o_settings_container" id="amr_token_enabled_setting">
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_right_pane">
                                    <div class="mt16 row">
                                        <label for="amr_token_audience" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="amr_token_audience" nolabel="1" readonly="1"/>
<!--                                        <br/>-->
<!--                                        <button name="action_get_token_audience" icon="fa-arrow-right" type="object" string="Get Token Audience" class="btn-link" />-->
                                    </div>
                                    <div class="mt16 row">
                                        <label for="amr_token_secret" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="amr_token_secret" password="True" nolabel="1"/>
                                    </div>

                                    <div class="mt16 row">
                                        <label for="amr_token_retention_in" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="amr_token_retention_in" nolabel="1"/>
                                    </div>
                                    <div class="mt16 row">
                                        <label for="amr_token_expires_in" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="amr_token_expires_in" nolabel="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
