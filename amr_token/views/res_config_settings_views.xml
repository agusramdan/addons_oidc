<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="amr_resource.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='amr_resource_app']" position="after">
                <div id="amr_token_config" groups="base.group_erp_manager" attrs="{'invisible': [('module_amr_token', '=', False)]}">
                    <h2>JWT Token</h2>
                    <div class="row mt16 o_settings_container" >
                        <div class="col-xs-12 col-md-6 o_setting_box" >
                            <div class="o_setting_right_pane">
                                <div class="row">
                                    <label for="amr_token_signature_type" string="Signature Type" class="col-lg-3 o_light_label"/>
                                    <field name="amr_token_signature_type" />
                                </div>
                                <div class="row mt16" attrs="{'invisible': [('amr_token_signature_type', '!=', 'secret')]}">
                                    <label for="amr_token_secret_algorithm" string="Secret" class="col-lg-3 o_light_label"/>
                                    <field name="amr_token_secret" password="1"/>
                                </div>
                                <div class="row mt16" attrs="{'invisible': [('amr_token_signature_type', '!=', 'secret')]}">
                                    <label for="amr_token_secret_algorithm" string="Algorithm" class="col-lg-3 o_light_label"/>
                                    <field name="amr_token_secret_algorithm" />
                                </div>
                                <div class="row mt16" attrs="{'invisible': [('amr_token_signature_type', '!=', 'public_key')]}">
                                    <label for="amr_token_public_key_algorithm" string="Algorithm" class="col-lg-3 o_light_label"/>
                                    <field name="amr_token_public_key_algorithm" />
                                </div>
                                <div class="row mt16">
                                    <label for="amr_token_expires_in" string="Expires" class="col-lg-3 o_light_label"/>
                                    <field name="amr_token_expires_in" placeholder="e.g. 1000"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
